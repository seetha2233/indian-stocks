<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Runs the daily refresh at 16:45 local time (IST), Monday to Friday, after
NSE closes at 15:30 and Yahoo has published the day's bars.

Install:   cp deploy/com.indianaistock.refresh.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.indianaistock.refresh.plist
Run now:   launchctl start com.indianaistock.refresh
Uninstall: launchctl unload ~/Library/LaunchAgents/com.indianaistock.refresh.plist
Logs:      backend/logs/refresh.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.indianaistock.refresh</string>
    <key>WorkingDirectory</key>
    <string>/Users/Chandu/Desktop/indian-ai-stock/backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Chandu/Desktop/indian-ai-stock/.venv/bin/python</string>
        <string>-m</string>
        <string>app.scripts.refresh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/Chandu/Desktop/indian-ai-stock/backend/logs/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Chandu/Desktop/indian-ai-stock/backend/logs/refresh.log</string>
</dict>
</plist>
